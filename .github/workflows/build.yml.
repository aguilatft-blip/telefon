name: Build APK

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Descargar código
        uses: actions/checkout@v4

      - name: Instalar Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Instalar Gradle 8.7
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.7

      - name: Compilar APK (debug)
        run: |
          echo "=== Archivos en el repositorio ==="
          find . -maxdepth 3 -not -path './.git/*' | head -50
          SETTINGS=$(find . -name settings.gradle.kts -not -path './.git/*' | head -1)
          if [ -z "$SETTINGS" ]; then
            echo "ERROR: no se encontró settings.gradle.kts en el repositorio"
            exit 1
          fi
          DIR=$(dirname "$SETTINGS")
          echo "Proyecto encontrado en: $DIR"
          cd "$DIR"
          gradle assembleDebug --no-daemon --stacktrace

      - name: Subir APK
        uses: actions/upload-artifact@v4
        with:
          name: CustomDialer-apk
          path: '**/app-debug.apk'
